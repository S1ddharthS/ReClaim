# Copy this file to .env, then fill in your Jira Cloud values.
# Never commit .env or share your API token in chat.
JIRA_BASE_URL=https://YOUR-SITE.atlassian.net
JIRA_EMAIL=your-atlassian-account@example.com
JIRA_API_TOKEN=create-a-token-at-https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_PROJECT_KEY=RECL

# Fallback when API-token creation is unavailable: paste the browser session
# cookie from a signed-in Jira tab. Never commit .env or share the cookie.
# JIRA_COOKIE=atlassian.xsrf.token=...; cloud.session.token=...
